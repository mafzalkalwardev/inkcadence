{
  "name": "inkcadence",
  "version": "2.0.0",
  "description": "Write the words you supply in your own handwriting. Static site: the landing page and the app run in the browser, on the device.",
  "keywords": [
    "handwriting",
    "handwriting-synthesis",
    "handwritten-text",
    "offline-first",
    "privacy-first",
    "static-site",
    "browser",
    "vite"
  ],
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mafzalkalwardev/inkcadence.git"
  },
  "homepage": "https://mafzalkalwardev.github.io/inkcadence/",
  "bugs": {
    "url": "https://github.com/mafzalkalwardev/inkcadence/issues"
  },
  "browser": "index.html",
  "files": [
    "index.html",
    "sheet.html",
    "js/",
    "assets/",
    "web/",
    "docs/"
  ],
  "scripts": {
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "build:web": "npm run build --prefix web",
    "test": "node test/frontend.test.js && node test/engine.test.js && node test/lettersheet.test.js && node test/pipeline.test.js && node test/realism.test.js && node test/assignments.test.js",
    "test:pipeline": "node test/pipeline.test.js",
    "test:assignments": "node test/assignments.test.js",
    "fixtures:samples": "python scripts/make_sample_handwriting.py",
    "fixtures:assignments": "python scripts/make_assignment_fixtures.py",
    "lint": "node --check web/src/main.js && node --check js/app.js && node --check js/store.js && node --check js/config.js",
    "serve:static": "npx --yes serve . -l 4173",
    "train:charcnn": "python3 tools/charcnn/train_char_cnn.py",
    "train:charcnn:quick": "python3 tools/charcnn/train_char_cnn.py --quick"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "canvas": "^3.2.3"
  }
}
